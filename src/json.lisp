(in-package #:doc-extract-backend-docling)

;;; Minimal RFC 8259 codec + RFC 4648 base64. No HTTP/JSON backend dep —
;;; tests and convert payloads stay self-contained (same idea as S3 signing).

(defparameter +b64-alphabet+
  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

(defun base64-encode (octets)
  "RFC 4648 base64 (padded) of an octet vector or string (UTF-8 code units)."
  (let* ((bytes (etypecase octets
                  (string (map '(vector (unsigned-byte 8)) #'char-code octets))
                  ((vector (unsigned-byte 8)) octets)
                  (vector (make-array (length octets)
                                      :element-type '(unsigned-byte 8)
                                      :initial-contents octets))))
         (n (length bytes))
         (out (make-string-output-stream)))
    (loop for i from 0 below n by 3
          for b0 = (aref bytes i)
          for b1 = (if (< (1+ i) n) (aref bytes (1+ i)) 0)
          for b2 = (if (< (+ i 2) n) (aref bytes (+ i 2)) 0)
          for nleft = (- n i)
          for x = (logior (ash b0 16) (ash b1 8) b2)
          do (write-char (char +b64-alphabet+ (ldb (byte 6 18) x)) out)
             (write-char (char +b64-alphabet+ (ldb (byte 6 12) x)) out)
             (if (>= nleft 2)
                 (write-char (char +b64-alphabet+ (ldb (byte 6 6) x)) out)
                 (write-char #\= out))
             (if (>= nleft 3)
                 (write-char (char +b64-alphabet+ (ldb (byte 6 0) x)) out)
                 (write-char #\= out)))
    (get-output-stream-string out)))

(defun %b64-val (c)
  (cond
    ((char<= #\A c #\Z) (- (char-code c) (char-code #\A)))
    ((char<= #\a c #\z) (+ 26 (- (char-code c) (char-code #\a))))
    ((char<= #\0 c #\9) (+ 52 (- (char-code c) (char-code #\0))))
    ((char= c #\+) 62)
    ((char= c #\/) 63)
    (t nil)))

(defun base64-decode (string)
  "RFC 4648 base64 decode. Whitespace is ignored. Returns an octet vector."
  (let ((clean (make-array (length string)
                           :element-type 'character
                           :fill-pointer 0)))
    (loop for c across string
          unless (member c '(#\Space #\Tab #\Newline #\Return #\=))
            do (vector-push c clean))
    (let* ((n (length clean))
           (out (make-array (* 3 (ceiling n 4))
                            :element-type '(unsigned-byte 8)
                            :fill-pointer 0)))
      (loop for i from 0 below n by 4
            for v0 = (%b64-val (char clean i))
            for v1 = (if (< (1+ i) n) (%b64-val (char clean (1+ i))) 0)
            for v2 = (if (< (+ i 2) n) (%b64-val (char clean (+ i 2))) 0)
            for v3 = (if (< (+ i 3) n) (%b64-val (char clean (+ i 3))) 0)
            for x = (logior (ash (or v0 0) 18)
                            (ash (or v1 0) 12)
                            (ash (or v2 0) 6)
                            (or v3 0))
            do (when (and v0 v1)
                 (vector-push (ldb (byte 8 16) x) out))
               (when v2
                 (vector-push (ldb (byte 8 8) x) out))
               (when v3
                 (vector-push (ldb (byte 8 0) x) out)))
      (coerce out '(simple-array (unsigned-byte 8) (*))))))

(defun %json-skip-ws (s i)
  (loop while (and (< i (length s))
                   (member (char s i) '(#\Space #\Tab #\Newline #\Return)))
        do (incf i))
  i)

(defun %json-parse-string (s i)
  (unless (char= (char s i) #\")
    (error 'doc-extract-error :message "JSON string expected"))
  (let ((out (make-string-output-stream)))
    (incf i)
    (loop
      (when (>= i (length s))
        (error 'doc-extract-error :message "unterminated JSON string"))
      (let ((c (char s i)))
        (cond
          ((char= c #\")
           (return (values (get-output-stream-string out) (1+ i))))
          ((char= c #\\)
           (when (>= (1+ i) (length s))
             (error 'doc-extract-error :message "truncated JSON escape"))
           (let ((e (char s (1+ i))))
             (incf i 2)
             (case e
               (#\" (write-char #\" out))
               (#\\ (write-char #\\ out))
               (#\/ (write-char #\/ out))
               (#\b (write-char #\Backspace out))
               (#\f (write-char #\Page out))
               (#\n (write-char #\Newline out))
               (#\r (write-char #\Return out))
               (#\t (write-char #\Tab out))
               (#\u
                (when (> (+ i 4) (length s))
                  (error 'doc-extract-error :message "truncated \\u escape"))
                (write-char (code-char (parse-integer s :start i :end (+ i 4)
                                                      :radix 16))
                            out)
                (incf i 4))
               (t (write-char e out)))))
          (t
           (write-char c out)
           (incf i)))))))

(defun %json-parse-number (s i)
  (let ((start i))
    (when (and (< i (length s)) (char= (char s i) #\-))
      (incf i))
    (loop while (and (< i (length s)) (digit-char-p (char s i)))
          do (incf i))
    (when (and (< i (length s)) (char= (char s i) #\.))
      (incf i)
      (loop while (and (< i (length s)) (digit-char-p (char s i)))
            do (incf i)))
    (when (and (< i (length s)) (member (char s i) '(#\e #\E)))
      (incf i)
      (when (and (< i (length s)) (member (char s i) '(#\+ #\-)))
        (incf i))
      (loop while (and (< i (length s)) (digit-char-p (char s i)))
            do (incf i)))
    (let* ((token (subseq s start i))
           (int (ignore-errors (parse-integer token :junk-allowed nil))))
      (values (or int (read-from-string token)) i))))

(defun %json-parse-literal (s i word value)
  (unless (and (<= (+ i (length word)) (length s))
               (string= s word :start1 i :end1 (+ i (length word))))
    (error 'doc-extract-error
           :message (format nil "JSON expected ~a" word)))
  (values value (+ i (length word))))

(defun %json-parse-value (s i)
  (setf i (%json-skip-ws s i))
  (when (>= i (length s))
    (error 'doc-extract-error :message "unexpected end of JSON"))
  (let ((c (char s i)))
    (cond
      ((char= c #\") (%json-parse-string s i))
      ((or (char= c #\-) (digit-char-p c)) (%json-parse-number s i))
      ((char= c #\{) (%json-parse-object s i))
      ((char= c #\[) (%json-parse-array s i))
      ((char= c #\t) (%json-parse-literal s i "true" t))
      ((char= c #\f) (%json-parse-literal s i "false" nil))
      ((char= c #\n) (%json-parse-literal s i "null" :null))
      (t (error 'doc-extract-error
                :message (format nil "unexpected JSON char ~s at ~d" c i))))))

(defun %json-parse-object (s i)
  (unless (char= (char s i) #\{)
    (error 'doc-extract-error :message "JSON object expected"))
  (incf i)
  (let ((ht (make-hash-table :test #'equal)))
    (setf i (%json-skip-ws s i))
    (when (and (< i (length s)) (char= (char s i) #\}))
      (return-from %json-parse-object (values ht (1+ i))))
    (loop
      (setf i (%json-skip-ws s i))
      (multiple-value-bind (key ni) (%json-parse-string s i)
        (setf i (%json-skip-ws s ni))
        (unless (and (< i (length s)) (char= (char s i) #\:))
          (error 'doc-extract-error :message "JSON colon expected"))
        (multiple-value-bind (val ni2) (%json-parse-value s (1+ i))
          (setf (gethash key ht) val)
          (setf i (%json-skip-ws s ni2))))
      (cond
        ((and (< i (length s)) (char= (char s i) #\,))
         (incf i))
        ((and (< i (length s)) (char= (char s i) #\}))
         (return (values ht (1+ i))))
        (t (error 'doc-extract-error :message "JSON object comma or } expected"))))))

(defun %json-parse-array (s i)
  (unless (char= (char s i) #\[)
    (error 'doc-extract-error :message "JSON array expected"))
  (incf i)
  (let ((acc '()))
    (setf i (%json-skip-ws s i))
    (when (and (< i (length s)) (char= (char s i) #\]))
      (return-from %json-parse-array (values #() (1+ i))))
    (loop
      (multiple-value-bind (val ni) (%json-parse-value s i)
        (push val acc)
        (setf i (%json-skip-ws s ni)))
      (cond
        ((and (< i (length s)) (char= (char s i) #\,))
         (incf i))
        ((and (< i (length s)) (char= (char s i) #\]))
         (return (values (coerce (nreverse acc) 'vector) (1+ i))))
        (t (error 'doc-extract-error :message "JSON array comma or ] expected"))))))

(defun decode-json (source)
  "Decode a JSON string or UTF-8 octet vector to hash-tables / vectors."
  (let ((s (etypecase source
             (string source)
             ((vector (unsigned-byte 8))
              (map 'string #'code-char source)))))
    (multiple-value-bind (val i) (%json-parse-value s 0)
      (setf i (%json-skip-ws s i))
      (unless (>= i (length s))
        (error 'doc-extract-error :message "trailing JSON junk"))
      val)))

(defun %json-escape (s)
  (with-output-to-string (o)
    (write-char #\" o)
    (loop for c across s
          do (case c
               (#\" (write-string "\\\"" o))
               (#\\ (write-string "\\\\" o))
               (#\Newline (write-string "\\n" o))
               (#\Return (write-string "\\r" o))
               (#\Tab (write-string "\\t" o))
               (t
                (if (< (char-code c) 32)
                    (format o "\\u~4,'0x" (char-code c))
                    (write-char c o)))))
    (write-char #\" o)))

(defun %encode-json (value stream)
  (cond
    ((eq value :null) (write-string "null" stream))
    ((eq value t) (write-string "true" stream))
    ((null value) (write-string "false" stream))
    ((stringp value) (write-string (%json-escape value) stream))
    ((keywordp value) (write-string (%json-escape (string-downcase (symbol-name value))) stream))
    ((integerp value) (princ value stream))
    ((floatp value) (format stream "~F" value))
    ((hash-table-p value)
     (write-char #\{ stream)
     (let ((first t))
       (maphash (lambda (k v)
                  (unless first (write-char #\, stream))
                  (setf first nil)
                  (write-string (%json-escape (if (stringp k)
                                                  k
                                                  (string-downcase (princ-to-string k))))
                                stream)
                  (write-char #\: stream)
                  (%encode-json v stream))
                value))
     (write-char #\} stream))
    ((and (vectorp value) (not (stringp value)))
     (write-char #\[ stream)
     (loop for i from 0 below (length value)
           do (when (plusp i) (write-char #\, stream))
              (%encode-json (aref value i) stream))
     (write-char #\] stream))
    ((and (consp value) (consp (car value)))
     (write-char #\{ stream)
     (loop for rest on value
           for pair = (car rest)
           do (write-string (%json-escape (if (stringp (car pair))
                                              (car pair)
                                              (string-downcase (princ-to-string (car pair)))))
                            stream)
              (write-char #\: stream)
              (%encode-json (cdr pair) stream)
              (when (cdr rest) (write-char #\, stream)))
     (write-char #\} stream))
    ((listp value)
     (write-char #\[ stream)
     (loop for rest on value
           do (%encode-json (car rest) stream)
              (when (cdr rest) (write-char #\, stream)))
     (write-char #\] stream))
    (t (write-string (%json-escape (princ-to-string value)) stream))))

(defun encode-json (value)
  "Encode VALUE as a JSON string."
  (with-output-to-string (s)
    (%encode-json value s)))
